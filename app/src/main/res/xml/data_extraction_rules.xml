<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. 클라우드 백업은 전부 제외하고, 기기 간 전송은 DB(WAL 파일 포함)와 설정 파일만 포함합니다(ADR-0008). -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </cloud-backup>
  <device-transfer>
    <include domain="database" path="nextbill.db" />
    <include domain="database" path="nextbill.db-wal" />
    <include domain="database" path="nextbill.db-shm" />
    <include domain="file" path="datastore/settings.preferences_pb" />
  </device-transfer>
</data-extraction-rules>
